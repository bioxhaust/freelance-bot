TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
MY_SKILLS=Senior Fullstack: Python (FastAPI, async), Node.js (NestJS, Express), Next.js, React, TypeScript, REST API, webhooks, integrations, PostgreSQL, MySQL, SQLite, Redis, Docker, Linux, aiogram bots.
PREFILTER_INCLUDE_KEYWORDS=python,fastapi,django,flask,aiogram,telegram,бот,javascript,typescript,node,nestjs,next,react,frontend,backend,fullstack,api,rest,graphql,webhook,парсер,parser,scraping,automation,автоматизация,sql,postgres,mysql,sqlite,redis,docker,kubernetes,linux,devops,jwt,oauth,микросервис,интеграция,crm,saas,разработка,сайт,веб,landing,лендинг
PREFILTER_EXCLUDE_KEYWORDS=логотип,дизайн баннера,иллюстрация,копирайтинг,озвучка,seo-текст
RELEVANCE_THRESHOLD=70
DRAFT_MODE=1
# DRAFT_MAX_CHARS is hard-capped at 1500 in code (Telegram message limit is 4096
# and the rest of the card needs headroom). Values above 1500 are clamped.
# Bid length is the exchange ceiling: Kwork 2000, FL.ru 5000.
# scripts/check_draft_limits.py refuses anything longer.
# DRAFT_MAX_CHARS is kept for older setups and does not set that ceiling.
DRAFT_MAX_CHARS=900
POLL_INTERVAL_SECONDS=60
SOURCE_MAX_PAGES=5
# Only orders published after the bot's first launch are scored, and only
# while they are younger than this many minutes. 0 disables the age cap.
# The first launch stores the cutoff in the database (meta key notify_after).
FRESH_ORDER_MAX_AGE_MINUTES=60
# Kept so older .env files still load. It does not widen the window.
BACKLOG_MAX_AGE_MINUTES=180
LLM_CONCURRENCY=3
KWORK_COOKIES=
# Comma-separated rubric ids, checked live on 23 Oct 2026.
# 41 scripts/bots/mini apps, 37 site creation, 38 site fixes,
# 39 mobile apps, 80 desktop, 255 servers.
# 11 and 45 no longer return those rubrics and were dropping every Kwork card.
KWORK_CATEGORIES=41,37,38,39,80,255
FLRU_COOKIES=
# Local default is orders.db. Leave this unset on the server: docker-compose
# sets DB_PATH=/data/orders.db, and a value here would override that mount.
# DB_PATH=orders.db
